# ==============================================================================
# ATS RESUME INTELLIGENCE STUDIO - ENVIRONMENT CONFIGURATION BLUEPRINT
# ==============================================================================
# Copy this file to .env or .env.local for development and production environments.
# NEVER commit real secret credentials or production API keys to source control!

# ------------------------------------------------------------------------------
# APPLICATION ENVIRONMENT & PORTS
# ------------------------------------------------------------------------------
NODE_ENV=development
API_PORT=5000
WEB_PORT=3000
API_BASE_URL=http://localhost:5000
WEB_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (MONGODB)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/ats_resume_studio

# ------------------------------------------------------------------------------
# SESSION & AUTHENTICATION SECURITY
# ------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=super_secret_session_cryptographic_key_min_32_characters_long
SESSION_MAX_AGE_SECONDS=604800
PASSWORD_RESET_TOKEN_SECRET=super_secret_password_reset_token_signing_key_32_chars

# ------------------------------------------------------------------------------
# EMAIL SMTP CONFIGURATION (NODEMAILER)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_verified_sender_email@gmail.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM_NAME="ATS Resume Intelligence Studio"
SMTP_FROM_EMAIL=your_verified_sender_email@gmail.com

# ------------------------------------------------------------------------------
# MULTI-FACTOR EMAIL OTP POLICIES
# ------------------------------------------------------------------------------
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ------------------------------------------------------------------------------
# GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# Official Google GenAI SDK key (Express backend only - NEVER expose to client)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# AI GOVERNANCE & BUDGET LIMITS
# ------------------------------------------------------------------------------
AI_MONTHLY_BUDGET=100.00
AI_DAILY_REQUEST_LIMIT=50

# ------------------------------------------------------------------------------
# FILE STORAGE & UPLOAD RESTRICTIONS
# ------------------------------------------------------------------------------
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_TEMP_DIRECTORY=./storage/temp

# ------------------------------------------------------------------------------
# APPLICATION LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL=info

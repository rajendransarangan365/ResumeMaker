<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= subject %></title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #f8fafc;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      color: #334155;
    }
    .wrapper {
      width: 100%;
      background-color: #f8fafc;
      padding: 40px 16px;
    }
    .container {
      max-width: 560px;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
      border: 1px solid #e2e8f0;
    }
    .header {
      background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
      padding: 32px 24px;
      text-align: center;
    }
    .brand-title {
      color: #ffffff;
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.5px;
      margin: 0;
    }
    .brand-subtitle {
      color: #bfdbfe;
      font-size: 13px;
      margin-top: 4px;
      font-weight: 500;
    }
    .content {
      padding: 36px 32px;
    }
    .title {
      font-size: 22px;
      font-weight: 700;
      color: #0f172a;
      margin: 0 0 12px 0;
      letter-spacing: -0.5px;
    }
    .paragraph {
      font-size: 15px;
      line-height: 1.6;
      color: #475569;
      margin: 0 0 24px 0;
    }
    .otp-container {
      background: #f0f7ff;
      border: 1px dashed #93c5fd;
      border-radius: 12px;
      padding: 24px 16px;
      margin: 28px 0;
      text-align: center;
    }
    .otp-label {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #1e40af;
      margin-bottom: 12px;
    }
    .otp-digit {
      display: inline-block;
      width: 44px;
      height: 52px;
      line-height: 52px;
      background: #ffffff;
      border: 2px solid #2563eb;
      border-radius: 8px;
      text-align: center;
      font-size: 26px;
      font-weight: 800;
      font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
      color: #1e3a8a;
      box-shadow: 0 2px 4px rgba(37, 99, 235, 0.12);
      margin: 0 3px;
    }
    .expiry-badge {
      display: inline-block;
      margin-top: 14px;
      font-size: 12px;
      font-weight: 600;
      color: #d97706;
      background-color: #fef3c7;
      padding: 4px 12px;
      border-radius: 20px;
    }
    .info-list {
      background: #f8fafc;
      border-radius: 8px;
      padding: 16px 20px;
      margin: 24px 0;
      font-size: 13px;
      color: #64748b;
      line-height: 1.5;
    }
    .footer {
      background-color: #f8fafc;
      border-top: 1px solid #e2e8f0;
      padding: 20px 24px;
      text-align: center;
      font-size: 12px;
      color: #94a3b8;
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <div class="header">
        <h1 class="brand-title">ATS Resume Intelligence Studio</h1>
        <div class="brand-subtitle">AI-Powered ATS Optimization & Studio Suite</div>
      </div>
      <div class="content">
        <h2 class="title">Verify Your Email Address</h2>
        <p class="paragraph">
          <% if (typeof fullName !== 'undefined' && fullName) { %>
            Hello <strong><%= fullName %></strong>,
          <% } else { %>
            Hello,
          <% } %>
          <br>
          Thank you for joining ATS Resume Intelligence Studio. Use the highlighted 6-digit confirmation code below to verify your email and activate your account.
        </p>

        <div class="otp-container">
          <div class="otp-label">Your Verification Code</div>
          <table align="center" border="0" cellpadding="0" cellspacing="6" style="margin: 0 auto;">
            <tr>
              <% for(let i = 0; i < otp.length; i++) { %>
                <td style="width: 44px; height: 52px; background: #ffffff; border: 2px solid #2563eb; border-radius: 8px; text-align: center; vertical-align: middle; font-size: 26px; font-weight: 800; font-family: 'Courier New', Courier, monospace; color: #1e3a8a; box-shadow: 0 2px 4px rgba(37, 99, 235, 0.15);">
                  <%= otp[i] %>
                </td>
              <% } %>
            </tr>
          </table>
          <div class="expiry-badge">⏱ Expires in <%= typeof expiryMinutes !== 'undefined' ? expiryMinutes : 5 %> minutes</div>
        </div>

        <div class="info-list">
          • Enter this code on the verification page to complete your onboarding.<br>
          • For security reasons, this single-use code will expire shortly.<br>
          • If you did not create this account, you can safely ignore this email.
        </div>

        <p class="paragraph" style="margin-bottom: 0; font-size: 13px; color: #64748b;">
          Need help? Simply reply to this email or reach out to our support team.
        </p>
      </div>
      <div class="footer">
        © <%= new Date().getFullYear() %> ATS Resume Intelligence Studio. All rights reserved.<br>
        Automated Security Dispatch • Do not forward this code to anyone.
      </div>
    </div>
  </div>
</body>
</html>

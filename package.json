{
  "name": "ats-resume-intelligence-studio",
  "version": "1.0.0",
  "private": true,
  "description": "ATS Resume Intelligence Studio - Complete Enterprise Resume Intelligence Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start:api": "node apps/api/dist/server.js",
    "start:web": "npm run start --workspace=@ats/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "sharp": "^0.35.5",
    "typescript": "^5.7.3"
  }
}
